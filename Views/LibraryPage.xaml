<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfReader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PdfReader.Views.Components">

    <Grid MaxWidth="1400" Padding="28,12,28,0" RowSpacing="12" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <components:DocumentList
            x:Name="Documents"
            Grid.Row="1"
            FavoriteToggled="OnFavoriteToggled"
            OpenRequested="OnOpenRequested"
            RemoveRequested="OnRemoveRequested" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8A5;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
