<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfReader.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PdfReader.Views.Components"
    xmlns:loc="using:PdfReader.Localization">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1400"
            Padding="28,12,28,32"
            HorizontalAlignment="Stretch"
            Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock loc:Loc.Text="home.welcome" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    loc:Loc.Text="home.subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Quick access / drop target -->
            <Border
                Padding="28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8E5;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock loc:Loc.Text="home.open.title" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            loc:Loc.Text="home.open.desc"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        loc:Loc.Content="home.browse"
                        Command="{x:Bind ViewModel.PickCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock loc:Loc.Text="home.recent" Style="{StaticResource SubtitleTextBlockStyle}" />

                <components:DocumentList
                    x:Name="Recent"
                    FavoriteToggled="OnFavoriteToggled"
                    OpenRequested="OnOpenRequested"
                    RemoveRequested="OnRemoveRequested" />

                <!-- Empty state -->
                <StackPanel
                    Padding="0,32"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
