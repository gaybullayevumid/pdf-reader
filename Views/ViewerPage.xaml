<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfReader.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PdfReader.Localization"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:PdfReader.Views"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    loc:Loc.AutomationName="viewer.back"
                    loc:Loc.ToolTip="viewer.back"
                    Click="OnBack">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <ToggleButton
                    x:Name="PageListToggle"
                    Background="Transparent"
                    BorderThickness="0"
                    loc:Loc.AutomationName="viewer.pageList"
                    loc:Loc.ToolTip="viewer.pageList.tip"
                    Click="OnPageListToggle">
                    <FontIcon FontSize="16" Glyph="&#xE8A0;" />
                </ToggleButton>
            </StackPanel>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="PageBox"
                    Width="64"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Minimum="1"
                    loc:Loc.AutomationName="viewer.gotoPage"
                    loc:Loc.ToolTip="viewer.gotoPage"
                    SpinButtonPlacementMode="Hidden"
                    ValueChanged="OnPageBoxChanged" />
                <TextBlock
                    x:Name="PageCountText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <AppBarSeparator />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    loc:Loc.AutomationName="viewer.zoomOut"
                    loc:Loc.ToolTip="viewer.zoomOut"
                    Click="OnZoomOut">
                    <FontIcon FontSize="16" Glyph="&#xE71F;" />
                </Button>
                <DropDownButton
                    x:Name="ZoomButton"
                    Width="92"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="100%">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnFitWidth" loc:Loc.Text="viewer.fitWidth" />
                            <MenuFlyoutItem Click="OnFitPage" loc:Loc.Text="viewer.fitPage" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="0.5" Text="50%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="0.75" Text="75%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="1" Text="100%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="1.5" Text="150%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="2" Text="200%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="3" Text="300%" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    loc:Loc.AutomationName="viewer.zoomIn"
                    loc:Loc.ToolTip="viewer.zoomIn"
                    Click="OnZoomIn">
                    <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                </Button>
                <!--  Open PDF and full screen live in the window's navigation bar, which stays visible while reading.  -->
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            IsClosable="False"
            Severity="Error" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Page list: thumbnails are rendered only for the items the list has realized.  -->
            <Border
                x:Name="PageListPane"
                Width="176"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
                <ListView
                    x:Name="PageList"
                    Padding="0,4"
                    loc:Loc.AutomationName="viewer.pageList"
                    ContainerContentChanging="OnPageListContainerChanging"
                    SelectionChanged="OnPageListSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:PageThumbnail">
                            <StackPanel
                                Padding="0,8"
                                HorizontalAlignment="Center"
                                Spacing="4">
                                <Border
                                    Width="{x:Bind Width}"
                                    Height="{x:Bind Height}"
                                    Background="White"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Fill" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ScrollViewer
                x:Name="Scroller"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                FocusVisualPrimaryThickness="0"
                FocusVisualSecondaryThickness="0"
                IsTabStop="True"
                UseSystemFocusVisuals="False"
                SizeChanged="OnScrollerSizeChanged"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnViewChanged"
                ZoomMode="Disabled">
                <Canvas
                    x:Name="Pages"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent" />
            </ScrollViewer>

            <primitives:ScrollBar
                x:Name="DocumentBar"
                Grid.Column="1"
                HorizontalAlignment="Right"
                IndicatorMode="MouseIndicator"
                Orientation="Vertical"
                SmallChange="60"
                ValueChanged="OnDocumentBarChanged"
                Visibility="Collapsed" />

            <ProgressRing
                x:Name="BusyRing"
                Grid.Column="1"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
