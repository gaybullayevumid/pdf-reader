<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfReader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PdfReader.Views.Components"
    xmlns:loc="using:PdfReader.Localization">

    <ScrollViewer>
        <StackPanel
            Padding="28,12,28,32"
            MaxWidth="1400"
            HorizontalAlignment="Stretch"
            Spacing="6">

            <TextBlock
                Margin="0,0,0,10"
                loc:Loc.Text="settings.title"
                Style="{StaticResource TitleLargeTextBlockStyle}" />

            <!-- Appearance -->
            <TextBlock
                Margin="1,6,0,2"
                loc:Loc.Text="settings.appearance"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <components:SettingCard
                DescriptionKey="theme.desc"
                Glyph="&#xE790;"
                TitleKey="theme.title">
                <components:SettingCard.ActionContent>
                    <ComboBox
                        MinWidth="180"
                        loc:Loc.AutomationName="theme.title"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem loc:Loc.Content="theme.system" />
                        <ComboBoxItem loc:Loc.Content="theme.light" />
                        <ComboBoxItem loc:Loc.Content="theme.dark" />
                    </ComboBox>
                </components:SettingCard.ActionContent>
            </components:SettingCard>

            <!-- Language -->
            <TextBlock
                Margin="1,14,0,2"
                loc:Loc.Text="settings.language"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <components:SettingCard
                DescriptionKey="language.desc"
                Glyph="&#xE774;"
                TitleKey="language.title">
                <components:SettingCard.ActionContent>
                    <ComboBox
                        MinWidth="180"
                        loc:Loc.AutomationName="language.title"
                        DisplayMemberPath="NativeName"
                        ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                </components:SettingCard.ActionContent>
            </components:SettingCard>

            <!-- Window & Display -->
            <TextBlock
                Margin="1,14,0,2"
                loc:Loc.Text="settings.window"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <components:SettingCard
                DescriptionKey="window.fullscreen.desc"
                Glyph="&#xE740;"
                TitleKey="window.fullscreen.title">
                <components:SettingCard.ActionContent>
                    <ToggleSwitch
                        loc:Loc.AutomationName="window.fullscreen.title"
                        loc:Loc.OffContent="common.off"
                        loc:Loc.OnContent="common.on"
                        IsOn="{x:Bind ViewModel.IsFullScreen, Mode=TwoWay}" />
                </components:SettingCard.ActionContent>
            </components:SettingCard>
            <components:SettingCard
                DescriptionKey="window.remember.desc"
                Glyph="&#xE7F4;"
                TitleKey="window.remember.title">
                <components:SettingCard.ActionContent>
                    <ToggleSwitch
                        loc:Loc.AutomationName="window.remember.title"
                        loc:Loc.OffContent="common.off"
                        loc:Loc.OnContent="common.on"
                        IsOn="{x:Bind ViewModel.RememberWindowState, Mode=TwoWay}" />
                </components:SettingCard.ActionContent>
            </components:SettingCard>
            <components:SettingCard
                DescriptionKey="window.reset.desc"
                Glyph="&#xE777;"
                TitleKey="window.reset.title">
                <components:SettingCard.ActionContent>
                    <Button loc:Loc.Content="window.reset.button" Command="{x:Bind ViewModel.ResetWindowCommand}" />
                </components:SettingCard.ActionContent>
            </components:SettingCard>

            <!-- About -->
            <TextBlock
                Margin="1,14,0,2"
                loc:Loc.Text="settings.about"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <components:SettingCard
                DescriptionKey="about.desc"
                Glyph="&#xE946;"
                Title="PDF Reader" />
            <components:SettingCard
                Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                Glyph="&#xE895;"
                Title="{x:Bind ViewModel.VersionText, Mode=OneWay}">
                <components:SettingCard.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.InstallCommand}"
                            Content="{x:Bind ViewModel.InstallLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanInstall, Mode=OneWay}" />
                        <Button loc:Loc.Content="update.check" Command="{x:Bind ViewModel.CheckCommand}" />
                    </StackPanel>
                </components:SettingCard.ActionContent>
            </components:SettingCard>
            <components:SettingCard
                Glyph="&#xE72C;"
                TitleKey="about.auto">
                <components:SettingCard.ActionContent>
                    <ToggleSwitch
                        loc:Loc.AutomationName="about.auto"
                        loc:Loc.OffContent="common.off"
                        loc:Loc.OnContent="common.on"
                        IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                </components:SettingCard.ActionContent>
            </components:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
