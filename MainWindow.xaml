<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PdfReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PdfReader.Localization"
    xmlns:models="using:PdfReader.Models"
    Title="PDF Reader">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Shell layout, top to bottom, Windows 11 style:
          1. Title bar on Mica: app icon and name, library search (Ctrl+Space), system caption buttons.
          2. Navigation bar on Mica: the library pages, document actions, Settings on the right.
          3. Document tabs, merging into
          4. the content surface (a Fluent "layer" over Mica) that shows the page or the active document.
        Window-wide shortcuts live on the root, so their tooltip must stay hidden or it pops up anywhere over the window.
    -->
    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyboardAcceleratorPlacementMode="Hidden"
        SizeChanged="OnRootSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnToggleFullScreen" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator
                Key="Space"
                Invoked="OnSearchShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="O"
                Invoked="OnOpenShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseTabShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="F4"
                Invoked="OnCloseTabShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Tab"
                Invoked="OnNextTabShortcut"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Tab"
                Invoked="OnPreviousTabShortcut"
                Modifiers="Control,Shift" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1. Title bar. TitleBar keeps the search box clickable and leaves the rest as a drag region.  -->
        <TitleBar x:Name="AppTitleBar" Title="PDF Reader">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="180"
                MaxWidth="480"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                loc:Loc.AutomationName="search.name"
                loc:Loc.Placeholder="search.placeholder"
                QuerySubmitted="OnSearchQuerySubmitted"
                TextChanged="OnSearchTextChanged"
                TextMemberPath="Name"
                UpdateTextOnSelect="False">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PdfDocumentInfo">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xEA90;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Folder}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </TitleBar>

        <!--
            2. Horizontal navigation. Top mode gives the Fluent selection pill, moves entries that no longer fit
            into a "More" menu on narrow windows, and puts Settings at the far right after the PaneFooter actions.
            The bar and the content grid stay transparent: the tab strip and content surface below draw the layer.
        -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Top"
            SelectionChanged="OnSelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    loc:Loc.Content="nav.home"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.recent" Tag="recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.all" Tag="all">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.favorites" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.bookmarks" Tag="bookmarks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!--  Document actions, right-aligned before Settings. Subtle buttons: no fill until hovered.  -->
            <NavigationView.PaneFooter>
                <StackPanel
                    VerticalAlignment="Center"
                    KeyboardAcceleratorPlacementMode="Hidden"
                    Orientation="Horizontal"
                    Spacing="2">
                    <StackPanel.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                    </StackPanel.Resources>

                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        Height="36"
                        Padding="10,0"
                        loc:Loc.AutomationName="toolbar.open"
                        loc:Loc.ToolTip="toolbar.open.tip"
                        Command="{x:Bind ViewModel.OpenPdfCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                            <TextBlock x:Name="OpenLabel" loc:Loc.Text="toolbar.open" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="40"
                        Height="36"
                        Padding="0"
                        loc:Loc.AutomationName="toolbar.fullscreen"
                        loc:Loc.ToolTip="toolbar.fullscreen.tip"
                        Command="{x:Bind ViewModel.ToggleFullScreenCommand}">
                        <FontIcon FontSize="16" Glyph="&#xE740;" />
                    </Button>

                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="6,0,2,0"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    3. Open documents, one tab each, always shown so the workspace never jumps when the first file
                    opens. TabView brings the Fluent hover, selection and close animations, scroll buttons when tabs
                    overflow, and drag to reorder. The selected tab uses the surface's brush, so it merges into it.
                -->
                <TabView
                    x:Name="TabBar"
                    Margin="0,4,0,0"
                    Padding="8,0,8,0"
                    VerticalAlignment="Top"
                    AddTabButtonClick="OnAddTab"
                    AllowDropTabs="False"
                    Background="Transparent"
                    CanDragTabs="False"
                    CanReorderTabs="True"
                    CloseButtonOverlayMode="Auto"
                    IsAddTabButtonVisible="True"
                    SelectionChanged="OnTabSelectionChanged"
                    TabCloseRequested="OnTabCloseRequested"
                    TabItemsSource="{x:Bind TabService.Tabs}"
                    TabWidthMode="SizeToContent">
                    <TabView.Resources>
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    </TabView.Resources>
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="models:DocumentTab">
                            <TabViewItem
                                MaxWidth="240"
                                AutomationProperties.Name="{x:Bind Title}"
                                Header="{x:Bind Title}"
                                Tapped="OnTabTapped"
                                ToolTipService.ToolTip="{x:Bind Path}">
                                <TabViewItem.IconSource>
                                    <FontIconSource Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEA90;" />
                                </TabViewItem.IconSource>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>

                <!--  4. Content surface: the page in the Frame, or the active tab's viewer in front of it.  -->
                <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Margin="16,8,16,0"
                        Spacing="8">
                        <InfoBar
                            loc:Loc.Title="update.bar.title"
                            IsClosable="True"
                            IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                            Severity="Success">
                            <InfoBar.ActionButton>
                                <Button loc:Loc.Content="update.bar.install" Command="{x:Bind ViewModel.InstallUpdateCommand}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Severity="Informational" />
                    </StackPanel>

                    <Frame
                        x:Name="ContentFrame"
                        Grid.Row="1"
                        Padding="0,8,0,0">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition>
                                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                        <EntranceNavigationTransitionInfo />
                                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                </NavigationThemeTransition>
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>

                    <!--  The Frame underneath keeps its page while a document is shown.  -->
                    <Border
                        x:Name="DocumentHost"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <Border.ChildTransitions>
                            <TransitionCollection>
                                <ContentThemeTransition HorizontalOffset="0" VerticalOffset="8" />
                            </TransitionCollection>
                        </Border.ChildTransitions>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
