<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PdfReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PdfReader.Localization"
    Title="PDF Reader">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnToggleFullScreen" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="PDF Reader"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="260"
            PaneDisplayMode="Auto"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    loc:Loc.Content="nav.home"
                    Icon="Home"
                    IsSelected="True"
                    Tag="home" />
                <NavigationViewItem loc:Loc.Content="nav.recent" Tag="recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Content="nav.all" Tag="all">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    loc:Loc.Content="nav.favorites"
                    Icon="OutlineStar"
                    Tag="favorites" />
                <NavigationViewItem loc:Loc.Content="nav.bookmarks" Tag="bookmarks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top toolbar (hidden while reading: the viewer has its own bar). -->
                <CommandBar
                    x:Name="Toolbar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsOpen="False">
                    <AppBarButton
                        loc:Loc.Label="toolbar.open"
                        loc:Loc.ToolTip="toolbar.open.tip"
                        Command="{x:Bind ViewModel.OpenPdfCommand}"
                        Icon="OpenFile">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton
                        loc:Loc.Label="toolbar.fullscreen"
                        loc:Loc.ToolTip="toolbar.fullscreen.tip"
                        Command="{x:Bind ViewModel.ToggleFullScreenCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE740;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            loc:Loc.Label="nav.settings"
                            Click="OnOpenSettings"
                            Icon="Setting" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <StackPanel
                    Grid.Row="1"
                    Margin="16,0,16,8"
                    Spacing="8">
                    <InfoBar
                        loc:Loc.Title="update.bar.title"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                        Severity="Success">
                        <InfoBar.ActionButton>
                            <Button loc:Loc.Content="update.bar.install" Command="{x:Bind ViewModel.InstallUpdateCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Informational" />
                </StackPanel>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
