<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperFlow.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Background="Transparent"
                BorderThickness="0"
                Click="OnBack"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6">
                <NumberBox
                    x:Name="PageBox"
                    Width="64"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    ToolTipService.ToolTip="Go to page"
                    ValueChanged="OnPageBoxChanged" />
                <TextBlock
                    x:Name="PageCountText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <AppBarSeparator />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnZoomOut"
                    ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                    <FontIcon FontSize="16" Glyph="&#xE71F;" />
                </Button>
                <DropDownButton
                    x:Name="ZoomButton"
                    Width="92"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="100%">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnFitWidth" Text="Fit width (Ctrl+0)" />
                            <MenuFlyoutItem Click="OnFitPage" Text="Fit page" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="0.5" Text="50%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="0.75" Text="75%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="1" Text="100%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="1.5" Text="150%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="2" Text="200%" />
                            <MenuFlyoutItem Click="OnZoomPreset" Tag="3" Text="300%" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnZoomIn"
                    ToolTipService.ToolTip="Zoom in (Ctrl++)">
                    <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            IsClosable="False"
            Severity="Error" />

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            IsTabStop="True"
            SizeChanged="OnScrollerSizeChanged"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnViewChanged"
            ZoomMode="Disabled">
            <StackPanel
                x:Name="Pages"
                Padding="24"
                HorizontalAlignment="Center"
                Background="Transparent"
                Spacing="12" />
        </ScrollViewer>

        <ProgressRing
            x:Name="Loading"
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
